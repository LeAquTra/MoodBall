# MoodBall 配置模板。复制为 .env 后填写 Key。
# 所有配置都从环境变量读取；数据库里设置页保存的 Provider 优先于这里。

# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
LANGUAGE_CODE=zh-hans
TIME_ZONE=Asia/Shanghai
LOG_LEVEL=INFO
PERSONAL_MODE=1

# ---------- 数据库 / 媒体 / 静态 ----------
SQLITE_PATH=./db.sqlite3
CHECKPOINT_DB=./agent_checkpoints.sqlite3
MEDIA_ROOT=./media
MEDIA_URL=/media/
WEB_DIST=./web/dist
MAX_IMAGE_BYTES=2097152
DATA_UPLOAD_MAX_MEMORY_SIZE=12582912

# ---------- 本机 ASR 服务 ----------
ASR_ENABLED=1
ASR_BASE_URL=http://127.0.0.1:9100
ASR_WS_URL=ws://127.0.0.1:9100/asr/stream
# 本机模型目录；Windows 推荐 transformers，vLLM 流式需 Linux/WSL
ASR_MODEL_PATH=E:\Models\Qwen3-ASR-0.6B
ASR_BACKEND=transformers
ASR_DEVICE=cuda:0
ASR_DTYPE=bfloat16
ASR_STREAMING=0
ASR_LANGUAGE=Chinese
ASR_MAX_NEW_TOKENS=256
ASR_MAX_INFERENCE_BATCH_SIZE=1
ASR_PARTIAL_INTERVAL_MS=900
ASR_MAX_UTTERANCE_SECONDS=15
ASR_CHUNK_MS=200
ASR_CONNECT_TIMEOUT=5
ASR_RECONNECT_DELAY_MS=1000
ASR_GPU_MEMORY_UTILIZATION=0.55
ASR_MOCK=0
ASR_MOCK_TEXT=小d小d 看看 我 桌上 是 什么
ASR_VAD=1
ASR_VAD_THRESHOLD=0.012
ASR_VAD_MIN_SPEECH_MS=250
ASR_VAD_MIN_SILENCE_MS=700

# ---------- 智谱视觉 ----------
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
ZHIPU_VISION_MODEL=glm-4.6v-flash
ZHIPU_TIMEOUT=25

# ---------- DeepSeek 对话 ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=60

# ---------- 阿里百炼 TTS ----------
TTS_ENABLED=1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_API_KEY=
# 百炼业务空间；protocol=dashscope-speech / CosyVoice 会自动使用专属域名
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_WORKSPACE_BASE_URL=https://{workspace-id}.cn-beijing.maas.aliyuncs.com/api/v1
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanyang
TTS_FORMAT=wav
TTS_SAMPLE_RATE=24000
TTS_PROTOCOL=dashscope-speech
TTS_TIMEOUT=60
TTS_MAX_CHARS=600

# ---------- 摄像头（OpenCV） ----------
CAMERA_ENABLED=1
CAMERA_INDEX=0
CAMERA_BACKEND=dshow
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_QUALITY=82
CAMERA_MAX_EDGE=1280
CAMERA_WARMUP_FRAMES=5
CAMERA_IDLE_RELEASE_SECONDS=60
CAMERA_MIN_BRIGHTNESS=20
CAMERA_MIN_SHARPNESS=10

# ---------- 语音 / 唤醒 ----------
WAKE_WORD=小d小d
WAKE_VARIANTS=你好小d,嗨小d,你好小滴,你好小弟
WAKE_CHARS=弟滴迪低底地第丁d的
WAKE_CONFIRM_HITS=2
WAKE_CONFIRM_WINDOW_MS=1200
WAKE_COOLDOWN_MS=1500
COMMAND_TIMEOUT_MS=8000
WAKE_UTTERANCE_TIMEOUT_MS=5000
TTS_COOLDOWN_MS=300
VOICE_IDLE_TIMEOUT_MS=30000

# ---------- Agent / 工具 ----------
AGENT_ENABLED=1
AGENT_RECENT_MESSAGES=20
AGENT_SUMMARY_AFTER=20
AGENT_TEMPERATURE=0.7
AGENT_MAX_STEPS=4
AGENT_EMOTION_MIN_HOLD_MS=900
AGENT_DEFAULT_EMOTION=02
AGENT_PROMPT_LOCALE=zh-CN

# ---------- 长期记忆 ----------
MEMORY_ENABLED=1
# 每轮对话后异步提取 0-3 条事实；默认关闭，开启后每轮多一次模型调用
MEMORY_AUTO_EXTRACT=0
MEMORY_MAX_ITEMS=500
MEMORY_RECALL_LIMIT=5
MEMORY_PINNED_LIMIT=5
MEMORY_EXTRACT_TIMEOUT=25
MEMORY_DEDUPE_RATIO=0.9

# ---------- MCP / 工具注册表 ----------
MCP_ENABLED=1
MCP_CONFIG_PATH=./mcp_servers.json
MCP_MAX_TOOLS_PER_TURN=16
MCP_DEFAULT_TIMEOUT=30
MCP_TOOL_TTL_SECONDS=60
MCP_MAX_RESULT_CHARS=8000

# ---------- 数据保留 ----------
IMAGE_RETENTION_DAYS=7
VISION_RETENTION_DAYS=30
AUDIO_RETENTION_DAYS=7
EVENT_LOG_RETENTION_DAYS=30
TTS_CACHE_MAX_ITEMS=200
